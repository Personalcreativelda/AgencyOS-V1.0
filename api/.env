NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
API_URL=http://localhost:3001

# PostgreSQL connection string — works with Supabase, Neon, RDS, or any Postgres host.
# Local dev/staging: use `docker compose up -d` (see docker-compose.yml) — this is that stack's URL.
# Supabase: Project Settings → Database → Connection string (use the "Transaction" pooler on port 6543
# for the app, and add "?pgbouncer=true" — or the direct connection on 5432 for migrations).
# Swapping to a different provider later is just changing this URL, no code changes needed.
DATABASE_URL="postgresql://postgres.wphzfiwfgcmbpowfhsqr:%40pALMIRA0008@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# JWT (generate strong secrets for production)
JWT_SECRET=agencyflow_jwt_secret_dev_change_in_prod
JWT_REFRESH_SECRET=agencyflow_refresh_secret_dev_change_in_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI — server-wide fallback used when an agency hasn't connected its own key
# (Settings → Integração de IA in the app). Empty = mock responses, no cost.
OPENAI_API_KEY=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
AI_MODEL=gpt-4o-mini

# Storage — local disk or S3-compatible (MinIO, AWS S3, Cloudflare R2...).
# Local dev/staging: use `docker compose up -d` — this is that stack's MinIO config.
STORAGE_TYPE=s3
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=https://wphzfiwfgcmbpowfhsqr.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_ACCESS_KEY=3cb510c80159eb008423d5a7dd5e860c
S3_SECRET_KEY=90ebead94e96290a5aabcf5dba642b6ece1a5cfe8fa490cd86eb76b37c881e6f
S3_BUCKET=agencyos
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=https://wphzfiwfgcmbpowfhsqr.supabase.co/storage/v1/object/public

# Meta API (Facebook + Instagram) — this is a multi-tenant SaaS, so each agency registers its
# OWN Meta App and pastes the App ID/Secret in Settings → Redes Sociais (not here). This redirect
# URI is the server's own callback address — every agency's Meta App must whitelist this exact URL.
META_REDIRECT_URI=http://localhost:3001/api/v1/social/meta/callback
META_GRAPH_VERSION=v19.0

# WhatsApp via Evolution API (self-hosted, shared infra for all agencies) — https://doc.evolution-api.com
# EVOLUTION_API_KEY is the global admin key your Evolution API instance was started with.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Encryption key for secrets stored in the database (agency AI API keys, future social tokens).
# Generate a real random value for production — rotating it invalidates previously-stored secrets.
ENCRYPTION_KEY=agencyflow_enc_key_32chars_change_in_prod

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
