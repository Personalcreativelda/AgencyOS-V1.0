NODE_ENV=production
# Internal container port — not commonly used by other services, so it's less likely to collide
# on a shared VPS. Only the `web` container talks to this directly (via its nginx reverse proxy);
# you don't need to open it publicly unless you want direct API access.
PORT=4820
APP_URL=https://app.yourdomain.com
API_URL=https://api.yourdomain.com

# PostgreSQL connection string — works with Supabase, Neon, RDS, or any Postgres host.
# Local dev/staging: `docker compose up -d` (see docker-compose.yml at the repo root), then use
#   postgresql://agencyflow:agencyflow@localhost:5432/agencyflow
# Supabase: Project Settings → Database → Connection string (use the "Transaction" pooler on port
# 6543 with "?pgbouncer=true" for the running app; the direct connection on 5432 for migrations).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# JWT — generate real random secrets, never reuse the dev defaults.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI — this is only the server-wide fallback. Each agency can also connect its own key from
# Settings → Integração de IA in the app, which takes priority when configured.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Storage — local disk or S3-compatible (MinIO, AWS S3, Cloudflare R2...).
# Local dev/staging: `docker compose up -d` — MinIO console at http://localhost:9001
# (user/pass: agencyflow / agencyflow123), API at http://localhost:9000.
STORAGE_TYPE=s3
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agencyflow-assets
S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=   # set if storage sits behind a different public domain/CDN than S3_ENDPOINT

# Meta API (Facebook + Instagram) — this is a multi-tenant SaaS, so each agency registers its
# OWN Meta App and pastes the App ID/Secret in Settings → Redes Sociais (not here). This redirect
# URI is the server's own callback address — every agency's Meta App must whitelist this exact
# URL, and Settings → Redes Sociais shows agencies this exact same value to copy-paste, computed
# from wherever the app is actually running (window.location.origin), so the two can never drift
# apart as long as this env var matches the app's real public domain. In our Docker Compose setup
# only `web` has a public domain (its nginx proxies /api/* to `api` internally) — so this MUST be
# the SAME domain as APP_URL, not a separate api.* subdomain, even though `api` is its own container.
META_REDIRECT_URI=https://app.yourdomain.com/api/v1/social/meta/callback
META_GRAPH_VERSION=v19.0

# WhatsApp via Evolution API (self-hosted, shared infra for all agencies) — https://doc.evolution-api.com
# EVOLUTION_API_KEY is the global admin key your Evolution API instance was started with.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Encryption key for secrets stored in the database (agency AI API keys, future social tokens).
# Generate a real random value and never rotate it without a migration plan — rotating it makes
# every previously-encrypted secret undecryptable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
